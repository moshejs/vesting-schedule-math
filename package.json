{
  "name": "vesting-schedule-math",
  "version": "1.0.1",
  "description": "Equity vesting schedule math — cliff + monthly/quarterly/annual tranches, exact fractional-share conventions, vested-as-of queries, and single/double-trigger acceleration. Zero dependencies.",
  "keywords": [
    "vesting",
    "equity",
    "stock-options",
    "cap-table",
    "startup",
    "cliff",
    "acceleration",
    "rsu",
    "iso",
    "finance"
  ],
  "homepage": "https://moshemalka.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moshejs/vesting-schedule-math.git"
  },
  "bugs": "https://github.com/moshejs/vesting-schedule-math/issues",
  "author": "Moshe Malka <hello@moshemalka.com> (https://moshemalka.com)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
